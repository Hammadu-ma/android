<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AlifMed" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <item name="android:windowBackground">@color/brand_background</item>
    </style>

    <!-- Uses the AndroidX SplashScreen compat API so the native splash
         (icon fading into the app) looks the same and feels smooth on
         both old and new Android versions, not just Android 12+. -->
    <style name="Theme.AlifMed.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AlifMed</item>
    </style>
</resources>
